#!/bin/sh
#
# Blocks a commit that would introduce a credential.
#
# Installed by `npm run hooks:install`, and automatically by npm's `prepare`
# lifecycle on install. To bypass for one commit: `git commit --no-verify`.
#
# This scans the whole tracked tree rather than only the staged diff. That is
# deliberate and costs well under a second: a key already sitting in the tree is
# exactly the case the rotation runbook was written for, and a diff-only hook
# would let it live there forever as long as nobody touched that line again.

set -e

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found, skipping secret scan." >&2
  exit 0
fi

exec node "$(git rev-parse --show-toplevel)/scripts/scan-secrets.mjs"
