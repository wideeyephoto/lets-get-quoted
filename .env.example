NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. It bypasses RLS, and every cron worker, every /admin read and
# every server action that writes across accounts goes through it, via
# createAdminClient() in src/lib/auth.ts. It is ALSO the HMAC secret behind the
# QuickBooks OAuth state binding, unsubscribe tokens, subcontractor offer links
# and quick-stop verdict links. Every one of those sites reads it as `?? ''`, so
# a missing key does not throw -- it signs with a key anyone can guess and the
# flow keeps working end to end. Nothing will tell you it is absent.
SUPABASE_SERVICE_ROLE_KEY=

DATABASE_URL=

# Google Maps browser API. Map IDs are public identifiers, not secret keys.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=dcb10bb04a8ee6d4b12bca2a

# Server-side Google key, for geocoding (src/lib/geocode.ts) and drive time
# (src/lib/drive-time.ts). NOT the browser key above and not interchangeable
# with it: the browser key is HTTP-referrer-locked, so a server-to-server call
# carrying it gets a 403, and geocode.ts turns any failure into `return null`.
# The symptom is addresses that silently never resolve. The two names differ
# only by the NEXT_PUBLIC_ prefix, which is precisely how this one gets missed.
GOOGLE_MAPS_API_KEY=

# Stripe Connect
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Server-only rollout gate for the contractor-owned Accounts v2 Merchant
# onboarding surface. Leave 0 until the Merchant provisioning/readiness
# migrations and operator reconciliation runbook are deployed. This only
# exposes onboarding; it does not switch any homeowner payment rail.
LGQ_STRIPE_MERCHANT_ONBOARDING_V2_ENABLED=0

# Server-only Stripe Billing Price bindings for paid LGQ base plans. Set mode to
# the exact string 0 for Stripe test/sandbox Prices or 1 for live Prices. Every
# Price must be active, single-currency tax-exclusive USD, licensed/non-metered,
# and carry these metadata keys: lgq_price_purpose=base_plan, lgq_plan_code,
# lgq_billing_interval, and lgq_catalog_version=<PRICING_CATALOG_VERSION>.
# That last one is compared character-for-character and MOVES: read it from
# src/lib/billing/catalog.ts rather than from here, and run
# `npm run preflight:prices` where the Production vars are to check. Flex and
# Enterprise are not bound here.
LGQ_STRIPE_BILLING_LIVEMODE=0
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_ANNUAL=

# Dedicated platform-level Stripe Billing webhook. This secret must be different
# from STRIPE_WEBHOOK_SECRET. Leave the exact-1 gate off until the event
# projection and allowance-reset workers are scheduled, monitored, and have an
# operator reconciliation path.
STRIPE_BILLING_WEBHOOK_SECRET=
LGQ_STRIPE_BILLING_WEBHOOK_ENABLED=0

# Lets an owner cancel their own base plan from Settings -- and restore it again
# before it takes effect -- which the Terms, the checkout consent box, the
# homepage and the FAQ all promise. It schedules cancel_at_period_end rather than
# ending access they have paid for, and the resulting
# customer.subscription.updated is projected by the existing worker.
#
# So it depends on LGQ_STRIPE_BILLING_WEBHOOK_ENABLED being on AND the projection
# worker being scheduled: without both, a cancellation succeeds at Stripe and is
# never reflected in the workspace. Both were satisfied in production on
# 2026-08-20 and this flag was turned on there.
#
# It must also go on BEFORE LGQ_BASE_PLAN_SUBSCRIPTION_CHECKOUT_ENABLED, never
# after. Reversed, a customer can buy a plan the product gives them no way out
# of, which is the thing four separate pages promise they will never be.
LGQ_BASE_PLAN_SUBSCRIPTION_CANCELLATION_ENABLED=0

# Moving between PAID plans -- the immediate upgrade and the paid change
# scheduled for renewal. Moving to Flex is cancelling and is NOT covered by this
# flag; it has its own above.
#
# DO NOT TURN THIS ON YET. It is off because the rail underneath it does not
# exist, not because the surface is unfinished. A plan change must write a
# billing_subscription_checkout_operations row with purpose
# 'base_plan_plan_change' BEFORE calling Stripe, and nothing can write one:
# table writes are revoked from service_role, record_base_plan_recurring_consent
# refuses any workspace not on active Flex, and
# claim_stripe_billing_subscription_checkout refuses one with existing
# subscription history -- its own error message calls this "the future
# plan-change flow". Without that row the binding resolves the ORIGINAL
# checkout, still holding the old price, and every event for the subscription
# dead-letters after proration_behavior: 'always_invoice' has already taken the
# money.
#
# What should gate turning it on is an end-to-end projection test in test mode:
# a real upgrade, then the entitlement observed landing on the new plan. Not the
# migration, and not a design note. See docs/plan-change-fix-design.md.
LGQ_BASE_PLAN_SUBSCRIPTION_PLAN_CHANGE_ENABLED=0

# Dedicated Connect webhook for future direct charges made on contractor-owned
# Merchant accounts. Its signing secret must differ from both webhook secrets
# above. Leave the exact-1 gate off until the connected-payment projector and
# reconciliation worker are implemented and monitored.
STRIPE_CONNECTED_PAYMENT_WEBHOOK_SECRET=
LGQ_STRIPE_CONNECTED_PAYMENT_WEBHOOK_ENABLED=0

# Dedicated platform endpoint for top-up purchases, which arrive as
# checkout.session.* on the platform account -- types the Billing scope does not
# accept. Its signing secret must differ from all three secrets above. Base-plan
# signup also produces checkout.session.completed on this account, so this
# endpoint receives those too; the projector terminates them as
# top_up_not_a_purchase. Leave the exact-1 gate off until the top-up projection
# worker is scheduled and LGQ_TOP_UP_PURCHASE_ENABLED is ready to follow.
STRIPE_TOP_UP_WEBHOOK_SECRET=
LGQ_STRIPE_TOP_UP_WEBHOOK_ENABLED=0

# Drains the top-up inbox: a received event becomes a usage_credit_lots row.
# Turn the webhook above on first and prove receipt, then this. With it off,
# paid top-ups accumulate as received and are granted once it is enabled --
# nothing is lost, it is just not fulfilled yet.
LGQ_STRIPE_TOP_UP_PROJECTION_WORKER_ENABLED=0

# Gates the whole buying half: SKU-to-Price resolution, the durable claim in
# billing_top_up_purchase_operations, Checkout Session creation, the Server
# Action, and the Buy add-on credits card on Account -> Plan & usage. With it
# off no control renders anywhere and the entrypoint returns before auth.
#
# The receipt and projection halves were proven end to end on 2026-08-18, but
# their own flags above are still 0 -- so turning THIS one on first would take
# money for credits nothing would grant. Turn the two above on, prove a real
# purchase arrives and is granted, and only then turn this on. Note that the
# projection worker runs on a Vercel cron, which fires only against Production.
LGQ_TOP_UP_PURCHASE_ENABLED=0

# Server-only rollout gate for Account -> Plan & usage. Leave 0 until the new
# entitlement migrations and plan-priced direct-payment rail are active in the
# same environment. Missing and every value other than the exact string 1 are off.
LGQ_PRICING_DASHBOARD_ENABLED=0

# Server-only rollout gate for the owner-facing EXTRA USAGE switch: turning
# overage on, choosing a spending limit, and turning it off. Separate from the
# flag above on purpose -- showing somebody what they are spending and letting
# them authorize more spending are different decisions. Requires migration
# 20260822100000 (set_workspace_overage_authorization) to be applied in the same
# environment, because the control has nothing to call without it. Missing and
# every value other than the exact string 1 are off.
LGQ_OVERAGE_SELF_SERVE_ENABLED=0

# Freezes ended billing periods into immutable settlement rows via
# close_overage_period. Touches no money -- it only snapshots what the mutable
# accrual table already says. Safe to run ahead of the settlement worker below;
# it simply produces rows nothing drains yet.
LGQ_OVERAGE_PERIOD_CLOSE_ENABLED=0

# Drains frozen settlements into Stripe INVOICE ITEMS. This one creates real
# charges, so it is a separate flag from the closer above and must not be turned
# on until the closed rows have been eyeballed. Note there is no Stripe catalog
# work behind this: an invoice item carries its own amount and needs no Price.
LGQ_OVERAGE_SETTLEMENT_ENABLED=0

# Server-only rollout gate for the first Flex -> paid base-plan Checkout form
# and mutation. Leave 0 until verified Stripe Prices, recurring-consent RPCs,
# subscription event projection, allowance resets, webhook processing, and
# operator reconciliation are active in the same environment. Missing and every
# value other than the exact string 1 are off; the action returns before auth,
# rate limiting, consent, database claims, or Stripe while this remains off.
LGQ_BASE_PLAN_SUBSCRIPTION_CHECKOUT_ENABLED=0

# Server-only rollout gate for debiting one AI Intake credit per public lead
# thread. Leave 0 until entitlements and usage credit lots are seeded. Missing
# and every value other than the exact string 1 are off; the classic behavior
# makes no ledger calls while this remains off.
LGQ_AI_INTAKE_USAGE_GATE_ENABLED=0

# Server-only rollout gate for enforcing workspace_entitlements.feature_limits
# crew_users on active employee roster identities. Leave 0 until the crew-seat
# migration is installed. Missing and every value other than the exact string 1
# are off; the legacy crew actions make no entitlement RPCs while it remains off.
LGQ_CREW_SEAT_ENTITLEMENT_GATE_ENABLED=0

# Server-only DARK rollout gate for future office-user membership creation.
# Leave 0 until invitation, office-role authorization, removal/reactivation,
# crew-promotion, and team-management UI semantics are implemented. Missing and
# every value other than the exact string 1 are off. No active caller exists.
LGQ_OFFICE_SEAT_ENTITLEMENT_GATE_ENABLED=0

# Shared bearer secret for authenticated Vercel cron routes. The billing
# schedules are deployed dark and return before reading this secret while their
# exact-1 gates remain off. Enable projection first, then allowance resets, only
# after the Billing webhook, migrations, monitoring, and reconciliation runbook
# have been verified end to end. Enable connected-payment projection only after
# the connected webhook, event projector/worker migrations, connected-account
# retrieval proof, monitoring, and reconciliation runbook are verified. Enable
# direct-payment settlement only after Merchant projection is active and the
# settlement/SMS migrations, provider configuration, and indeterminate-delivery
# runbook are verified.
CRON_SECRET=
LGQ_STRIPE_SUBSCRIPTION_PROJECTION_WORKER_ENABLED=0
LGQ_STRIPE_CONNECTED_PAYMENT_PROJECTION_WORKER_ENABLED=0
LGQ_PAID_PLAN_ALLOWANCE_RESET_WORKER_ENABLED=0
LGQ_DIRECT_PAYMENT_SETTLEMENT_WORKER_ENABLED=0

# DARK legacy destination-charge Quick Stop late-refund executor. Keep this 0.
# Activation is blocked until all of these are true in the target environment:
# migration 20260816093000 is applied and preflighted; CRON_SECRET is present;
# Stripe Test has a platform webhook destination delivering charge.refunded to
# /api/stripe/webhook; and the live legacy endpoint's charge.refunded projection
# is verified to reconcile payments before the completion RPC runs. Only then
# may this exact-1 gate be enabled. Missing/every non-literal-1 value stays off.
LGQ_LEGACY_QUICK_STOP_LATE_REFUND_WORKER_ENABLED=0

# DARK exact-1 cutover for serialized legacy destination-charge Checkout
# generations. Keep 0 until the legacy destination Checkout ledger migration is
# installed, existing production Session pointers have an explicit audited
# adoption/backfill decision, and signed predecessor success/failure handling is
# verified. Missing and every non-literal-1 value remain on the legacy path.
LGQ_LEGACY_DESTINATION_CHECKOUT_GENERATION_ENABLED=0

# DARK exact-1 handover of legacy destination-charge SETTLEMENT from the webhook
# route's compare-and-set to classify_legacy_destination_checkout_event. This is a
# switch, not an addition: the route's rail guard covers exactly the payments that
# RPC also mutates, so while this is 1 the route stands down and the ledger is the
# only authority. Turning both on at once is the failure to avoid.
#
# Enable strictly AFTER generation above, never alongside it, and only once every
# in-flight Checkout has an operation row. The classifier resolves a payment
# through that row; a payment created before the foundation has none, reports
# unknown, and projects nothing — money collected at Stripe with nothing written
# locally and no error raised. Missing and every non-literal-1 value keep the
# route's compare-and-set in charge.
LGQ_LEGACY_DESTINATION_CHECKOUT_PROJECTION_ENABLED=0

# DARK cutover gates for replacing the legacy webhook's non-transactional
# payment-plan and Quick Stop side effects with their replay-safe RPCs. The
# signed legacy webhook is the gated caller. Keep both 0 until migrations 20260816091500,
# 20260816093000, and 20260816100000 are applied and preflighted; every existing
# timestamp-only payoff lock is explicitly bound or cleared; the legacy webhook
# passes only signature-verified destination events whose Session/PaymentIntent
# IDs exactly match the persisted payment; saved-card evidence is proven for paid
# deposits; the old callbacks are replaced (not also invoked); and the Quick Stop
# late-refund worker/webhook reconciliation path is monitored. Missing and every
# non-literal-1 value remain off.
LGQ_LEGACY_PAYMENT_PLAN_PROJECTION_ENABLED=0
LGQ_LEGACY_QUICK_STOP_RECONCILIATION_ENABLED=0

# Canonical deployed application origin used in homeowner links and every
# provider webhook signature/callback URL. Production must be a bare HTTPS
# origin under NEXT_PUBLIC_ROOT_DOMAIN: no credentials, port, path, query, or
# fragment. Preview/localhost values deliberately cannot authorize carrier I/O.
NEXT_PUBLIC_APP_URL=http://localhost:3010

# ---------------------------------------------------------------------------
# Transactional SMS and voice. Twilio or SignalWire — see src/lib/sms-provider.
#
# The provider is INFERRED from which credentials are present, so there is no
# way to select one whose secrets are missing. Set one block below.
#
# Set LGQ_SMS_PROVIDER only during a migration, when BOTH blocks are filled in
# on purpose (inbound has to keep validating webhooks signed by either). With
# both present and this unset, Twilio wins — never drift to the new provider
# just because its variables appeared. Naming a provider whose credentials are
# absent turns sending OFF rather than falling back to the other one.
LGQ_SMS_PROVIDER=
# Dark worker gate. Keep 0 until the migration, sender inventory, callbacks,
# and canary account have all passed staging verification.
LGQ_SMS_DELIVERY_WORKER_ENABLED=0
# Retry ordinary inbound actions whose synchronous callback attempt crashed.
# The webhook still processes its own receipt immediately; this scheduled
# backstop remains dark until the migration and staging callback tests pass.
LGQ_SMS_INBOUND_ACTION_WORKER_ENABLED=0
# Optional comma-separated workspace UUIDs. When non-empty, claimed work for
# every other workspace is deferred before any provider request begins.
LGQ_SMS_CANARY_ACCOUNT_IDS=
# Each traffic lane stays dark until its campaign/product release gate passes.
LGQ_SMS_SHARED_ENABLED=0
LGQ_SMS_DISPATCH_ENABLED=0
LGQ_SMS_CONTRACTOR_MESSAGING_ENABLED=0

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Use TWILIO_FROM_NUMBER instead when no Messaging Service is configured.
TWILIO_FROM_NUMBER=

# --- SignalWire ---
# The Space host, with or without the scheme: yourspace.signalwire.com
# This is SignalWire's alone — Twilio has no equivalent — which is what makes
# its presence a safe thing to infer the provider from.
SIGNALWIRE_SPACE_URL=
# Doubles as the {AccountSid} path segment and the Basic-auth username.
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
# SignalWire's answer to a Messaging Service: a Number Group id (a UUID, not an
# MG... SID). Provisioned on the Relay REST API, not the compatibility one.
SIGNALWIRE_NUMBER_GROUP_ID=
SIGNALWIRE_FROM_NUMBER=
# Required for SignalWire Messaging inbound/status callbacks and the signed
# compatibility voice admission/status routes. Copy the distinct Signing Key
# from Dashboard > API Credentials. It never falls back to the API token, so
# outbound credentials alone cannot accidentally authenticate input. SignalWire
# AI Agent end-of-call receipts are a different JSON + HTTP Basic contract and
# use LGQ_VOICE_RECEIPT_BASIC below, never this key.
SIGNALWIRE_SIGNING_KEY=

# Dedicated contractor-number provisioning. This is intentionally separate
# from the SMS delivery worker: only the exact string 1 permits provider
# mutations that can purchase or alter a number. Leave 0 until the private-beta
# migration, downstream-brand vetting, SignalWire token scopes, callback auth,
# and an MFA operator walkthrough have all passed in staging.
LGQ_SIGNALWIRE_PROVISIONING_ENABLED=0
# Optional operator proposal shown when creating the first service-only database
# spend policy. These values never authorize a purchase: each claim must exactly
# match the persisted policy revision and its aggregate ceiling under the database
# lock. With no database policy row, purchase fails closed. Enter only a carrier
# price operations independently reviewed; the SignalWire purchase API returns no quote.
LGQ_SIGNALWIRE_NUMBER_MONTHLY_PRICE_CENTS=
LGQ_SIGNALWIRE_NUMBER_MONTHLY_SPEND_CEILING_CENTS=
# Production HTTPS endpoint SignalWire should POST inbound messages to when an
# approved dedicated number is configured. It must exactly equal
# ${NEXT_PUBLIC_APP_URL}/api/sms/inbound and contain no credentials, query, or
# fragment. The provider response must confirm LaML webhooks over POST.
LGQ_SIGNALWIRE_INBOUND_WEBHOOK_URL=
# Production HTTPS endpoint SignalWire should POST 10DLC Campaign Registry
# status callbacks to. It must exactly equal
# ${NEXT_PUBLIC_APP_URL}/api/sms/registry-status/${LGQ_SIGNALWIRE_10DLC_CALLBACK_TOKEN}
# and contain no credentials, query, or fragment -- the outbound validator
# rejects all three, which is why the token is a path segment.
#
# Setting this without a matching token throws rather than silently registering
# an unauthenticated callback. Activation still polls and trusts only the
# individual assignment state, never an order-level "processed" state and never
# this callback: the callback records evidence, it does not activate.
LGQ_SIGNALWIRE_10DLC_STATUS_CALLBACK_URL=
# Shared secret carried as the path segment of the callback URL above, and the
# entire authentication of that route. 32-128 chars of [A-Za-z0-9_-]. Rotate by
# setting both this and the URL together, then redeploying -- Vercel bakes env
# at build, so neither takes effect until a redeploy.
LGQ_SIGNALWIRE_10DLC_CALLBACK_TOKEN=
# Set to '1' to REJECT (403) registry callbacks whose signature does not verify.
# Leave unset while measuring.
#
# SignalWire documents no signing for the Campaign Registry surface, but real
# deliveries captured 2026-08-22 carry `x-signalwire-signature`, and exactly one
# construction reproduces them:
#
#   HMAC-SHA1(SIGNALWIRE_SIGNING_KEY, callback_url + raw_body) -> HEX
#
# HEX, not the base64 the rest of the messaging rail uses -- reusing
# validateWebhookSignature here would reject every genuine delivery. A scheme
# derived from captured traffic is evidence, not a contract, so the route
# records the verdict and only enforces once this is set. Turning it on before
# real traffic shows a consistent `valid` risks 403ing the provider and losing
# the very failure reason this endpoint exists to capture.
LGQ_SIGNALWIRE_REGISTRY_REQUIRE_SIGNATURE=

# HMAC secret for stateless lead phone-verification tokens. NOT a provider
# credential — it only ever lived on TWILIO_AUTH_TOKEN by accident, and the
# fallback below exists so renaming that variable does not invalidate every
# in-flight token. Set this to the CURRENT value of TWILIO_AUTH_TOKEN when you
# first add it, then rotate it on its own schedule. It must be set before
# TWILIO_AUTH_TOKEN is removed: with neither present, phone verification stops
# running and every affected lead is flagged as unverified.
LGQ_LEAD_VERIFICATION_SECRET=

# Signing secret for the Resend delivery-status webhook (bounces/complaints,
# recorded into email_events for the admin Command Center). Set once the
# webhook is configured in the Resend dashboard against /api/resend/webhook.
RESEND_WEBHOOK_SECRET=

# --- AI Voice Receptionist (Phase 4) ------------------------------------------
# Three separate switches, because "stop charging for this" and "stop doing
# this" must not be the same lever.
#
#   LGQ_AI_VOICE_ENABLED      the AI answers at all
#   LGQ_VOICE_MINUTE_METER..  minutes are written to the ledger
#   LGQ_VOICE_MINUTE_GATE..   an exhausted allowance may refuse (needs METER too)
#
# Measure before enforcing: turn the meter on, read a period of real usage, then
# the gate. Each is the exact string 1 or it is off.
LGQ_AI_VOICE_ENABLED=0
LGQ_VOICE_MINUTE_METER_ENABLED=0
LGQ_VOICE_MINUTE_GATE_ENABLED=0

# The sweep that puts each workspace's monthly minutes in its ledger. Turn this
# on BEFORE the meter: with no minutes granted, metering measures nothing and
# the gate would send every caller to voicemail. Deliberately separate from the
# paid-plan allowance reset, which grants four canonical resources and hard-codes
# success as exactly four -- voice riding along would risk every other credit.
LGQ_VOICE_ALLOWANCE_WORKER_ENABLED=0

# Gives a refunded payment its reconciliation back. Until this runs, a payment
# refunded once can never be refunded again: the refund gate requires
# `reconciled`, every refund sets `pending`, and nothing else has ever written
# `reconciled` after the original checkout projection.
LGQ_REFUND_RECONCILIATION_ENABLED=0

# The purchased-capacity lifecycle sweep. Without it a cancelled seat or storage
# subscription keeps granting for ever, which is why every recurring SKU is
# withheld. Turn this on BEFORE unwithholding any of them.
LGQ_PURCHASED_CAPACITY_LIFECYCLE_ENABLED=0

# Enforces the storage cap. Metering is measured and shown without it; this is
# what makes bought headroom mean anything.
LGQ_STORAGE_CAP_ENFORCED=0
LGQ_WORKSPACE_STORAGE_USAGE_SWEEP_ENABLED=0

# Releases usage reservations whose work never finished. Load-bearing for AI
# Voice, where a call that fails while connecting sends no receipt at all.
LGQ_USAGE_RESERVATION_EXPIRY_ENABLED=0

# Allows a workspace that has authorized an overage AND set a cap to exceed its
# allowance. Off means an exhausted allowance refuses rather than bills.
LGQ_USAGE_OVERAGE_ENABLED=0

# The three older meters, each measure-then-enforce like the voice pair above.
LGQ_TEXT_CREDIT_METER_ENABLED=0
LGQ_TEXT_CREDIT_GATE_ENABLED=0
LGQ_MARKETING_EMAIL_METER_ENABLED=0
LGQ_MARKETING_EMAIL_GATE_ENABLED=0
LGQ_AI_WRITING_METER_ENABLED=0
LGQ_AI_WRITING_GATE_ENABLED=0

# Basic credentials for the end-of-call receipt endpoint, as `user:password`.
#
# SignalWire AI Agents send NO signature and expose no signing secret, so
# the SWML route sends these through SignalWire's separate
# post_prompt_auth_user/post_prompt_auth_password fields. Never put this value
# in the callback URL or logs. Unset means the endpoint refuses everything,
# which is the correct default for a route that accepts unsigned billing
# evidence. Use a value dedicated to this endpoint and nothing else: reusing the
# SMS signing key would make a valid SMS delivery a valid receipt.
LGQ_VOICE_RECEIPT_BASIC=

# Checked against the receipt payload, so a receipt from another SignalWire
# project or space is refused rather than stored as though it were ours.
SIGNALWIRE_SPACE_ID=

# Internal admin console (/admin) staff allowlist. Comma-separated; each entry
# is either a bare email (role defaults to "admin") or "email:role" where role
# is one of admin|support|finance. Role only changes Command Center's default
# card set and nav visibility — every listed email is a full admin for server
# actions. Only these logged-in users can reach /admin; everyone else gets a 404.
ADMIN_EMAILS=

# --- Application identity -----------------------------------------------------
# The apex marketing domain. Used to tell a platform host (letsgetquoted.com,
# www., app.) apart from a contractor's own subdomain or custom domain, so it
# decides tenant resolution in src/middleware.ts as well as absolute links in
# webhooks and API routes. Absent, host resolution falls back to the literal
# 'letsgetquoted.com', which is wrong everywhere except production.
NEXT_PUBLIC_ROOT_DOMAIN=letsgetquoted.com

# Where a contractor's custom domain is pointed, and what the setup screen tells
# them to enter at their registrar. CNAME target has a built-in default; the A
# record has none, and without it apex-domain verification cannot match.
CUSTOM_DOMAIN_CNAME_TARGET=domains.letsgetquoted.com
CUSTOM_DOMAIN_A_RECORD=

# Site-wide notice that texting is still in carrier registration. It is ON by
# default and stays on until this is set to the exact string 'off' -- an empty
# value shows the banner. Read at build time, so changing it needs a redeploy.
NEXT_PUBLIC_LAUNCH_BANNER=

# --- Transactional email ------------------------------------------------------
# Resend API key. Every magic link, crew invite and customer email goes through
# it. Missing, src/lib/email.ts logs a console warning and returns -- callers
# see success and no mail is ever sent, including sign-in links.
RESEND_API_KEY=

# Physical postal address printed in marketing email footers when a contractor
# has not set their own. Absent, the address line is omitted; the unsubscribe
# link still ships. US CAN-SPAM expects a real mailing address on bulk mail.
COMPANY_MAILING_ADDRESS=

# --- AI --------------------------------------------------------------------
# OpenAI key for AI Intake lead classification, quote drafting and website copy
# generation. Those features fail closed without it; nothing else is affected.
OPENAI_API_KEY=

# --- Cloudflare Turnstile (contact form) --------------------------------------
# Site key is public and rendered in the browser; the secret verifies server
# side. NOTE the failure direction: src/app/contact/actions.ts returns true when
# TURNSTILE_SECRET is unset, so a missing secret does not block the form, it
# disables the spam check entirely. Fails OPEN, not closed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Web Push (crew field app) ------------------------------------------------
# VAPID keypair for push notifications to the crew PWA. Generate with
# `npx web-push generate-vapid-keys`. The public half is baked into the client
# bundle and must match the private half. Both absent, push degrades to a no-op
# and the UI hides itself; only one present is a misconfiguration.
# VAPID_SUBJECT defaults to mailto:hello@letsgetquoted.com.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- QuickBooks Online --------------------------------------------------------
# OAuth app credentials. quickBooksConfigured() is false unless BOTH the client
# id and secret are present, which hides the integration rather than breaking it.
# QUICKBOOKS_ENVIRONMENT selects the API host and is 'sandbox' unless set to the
# exact string 'production'. QUICKBOOKS_REDIRECT_URI is optional -- it is derived
# from NEXT_PUBLIC_APP_URL when blank -- but Intuit compares it character for
# character, including scheme and any trailing slash, so set it explicitly when
# the derived value would not match the app registration.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REDIRECT_URI=

# --- Stock imagery ------------------------------------------------------------
# Pexels key for the website builder's stock photo search. Without it the
# builder falls back to its bundled images.
PEXELS_API_KEY=

# --- Outbound SMS kill switch -------------------------------------------------
# Set to the exact string 1 to stop all outbound SMS while leaving the provider
# configured. Sends are already suppressed automatically under test and on
# Vercel Preview; this is the lever for Production.
LGQ_DISABLE_OUTBOUND_SMS=0

# --- Build --------------------------------------------------------------------
# Overrides Next's output directory (next.config.mjs). Only set by tooling that
# needs a build not to collide with .next; leave blank normally.
NEXT_DIST_DIR=
