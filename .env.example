NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=

# Google Maps browser API. Map IDs are public identifiers, not secret keys.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=dcb10bb04a8ee6d4b12bca2a

# Stripe Connect
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only rollout gate for the contractor-owned Accounts v2 Merchant
# onboarding surface. Leave 0 until the Merchant provisioning/readiness
# migrations and operator reconciliation runbook are deployed. This only
# exposes onboarding; it does not switch any homeowner payment rail.
LGQ_STRIPE_MERCHANT_ONBOARDING_V2_ENABLED=0

# Server-only Stripe Billing Price bindings for paid LGQ base plans. Set mode to
# the exact string 0 for Stripe test/sandbox Prices or 1 for live Prices. Every
# Price must be active, single-currency tax-exclusive USD, licensed/non-metered,
# and carry these metadata keys: lgq_price_purpose=base_plan, lgq_plan_code,
# lgq_billing_interval, and lgq_catalog_version=2026-08-15-preview. Flex and
# Enterprise are not bound here.
LGQ_STRIPE_BILLING_LIVEMODE=0
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_ANNUAL=

# Dedicated platform-level Stripe Billing webhook. This secret must be different
# from STRIPE_WEBHOOK_SECRET. Leave the exact-1 gate off until the event
# projection and allowance-reset workers are scheduled, monitored, and have an
# operator reconciliation path.
STRIPE_BILLING_WEBHOOK_SECRET=
LGQ_STRIPE_BILLING_WEBHOOK_ENABLED=0

# Dedicated Connect webhook for future direct charges made on contractor-owned
# Merchant accounts. Its signing secret must differ from both webhook secrets
# above. Leave the exact-1 gate off until the connected-payment projector and
# reconciliation worker are implemented and monitored.
STRIPE_CONNECTED_PAYMENT_WEBHOOK_SECRET=
LGQ_STRIPE_CONNECTED_PAYMENT_WEBHOOK_ENABLED=0

# Server-only rollout gate for Account -> Plan & usage. Leave 0 until the new
# entitlement migrations and plan-priced direct-payment rail are active in the
# same environment. Missing and every value other than the exact string 1 are off.
LGQ_PRICING_DASHBOARD_ENABLED=0

# Server-only rollout gate for the first Flex -> paid base-plan Checkout form
# and mutation. Leave 0 until verified Stripe Prices, recurring-consent RPCs,
# subscription event projection, allowance resets, webhook processing, and
# operator reconciliation are active in the same environment. Missing and every
# value other than the exact string 1 are off; the action returns before auth,
# rate limiting, consent, database claims, or Stripe while this remains off.
LGQ_BASE_PLAN_SUBSCRIPTION_CHECKOUT_ENABLED=0

# Server-only rollout gate for debiting one AI Intake credit per public lead
# thread. Leave 0 until entitlements and usage credit lots are seeded. Missing
# and every value other than the exact string 1 are off; the classic behavior
# makes no ledger calls while this remains off.
LGQ_AI_INTAKE_USAGE_GATE_ENABLED=0

# Server-only rollout gate for enforcing workspace_entitlements.feature_limits
# crew_users on active employee roster identities. Leave 0 until the crew-seat
# migration is installed. Missing and every value other than the exact string 1
# are off; the legacy crew actions make no entitlement RPCs while it remains off.
LGQ_CREW_SEAT_ENTITLEMENT_GATE_ENABLED=0

# Server-only DARK rollout gate for future office-user membership creation.
# Leave 0 until invitation, office-role authorization, removal/reactivation,
# crew-promotion, and team-management UI semantics are implemented. Missing and
# every value other than the exact string 1 are off. No active caller exists.
LGQ_OFFICE_SEAT_ENTITLEMENT_GATE_ENABLED=0

# Shared bearer secret for authenticated Vercel cron routes. The two billing
# schedules are deployed dark and return before reading this secret while their
# exact-1 gates remain off. Enable projection first, then allowance resets, only
# after the Billing webhook, migrations, monitoring, and reconciliation runbook
# have been verified end to end.
CRON_SECRET=
LGQ_STRIPE_SUBSCRIPTION_PROJECTION_WORKER_ENABLED=0
LGQ_PAID_PLAN_ALLOWANCE_RESET_WORKER_ENABLED=0

# Public URL used in homeowner payment links
NEXT_PUBLIC_APP_URL=http://localhost:3010

# ---------------------------------------------------------------------------
# Transactional SMS and voice. Twilio or SignalWire — see src/lib/sms-provider.
#
# The provider is INFERRED from which credentials are present, so there is no
# way to select one whose secrets are missing. Set one block below.
#
# Set LGQ_SMS_PROVIDER only during a migration, when BOTH blocks are filled in
# on purpose (inbound has to keep validating webhooks signed by either). With
# both present and this unset, Twilio wins — never drift to the new provider
# just because its variables appeared. Naming a provider whose credentials are
# absent turns sending OFF rather than falling back to the other one.
LGQ_SMS_PROVIDER=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Use TWILIO_FROM_NUMBER instead when no Messaging Service is configured.
TWILIO_FROM_NUMBER=

# --- SignalWire ---
# The Space host, with or without the scheme: yourspace.signalwire.com
# This is SignalWire's alone — Twilio has no equivalent — which is what makes
# its presence a safe thing to infer the provider from.
SIGNALWIRE_SPACE_URL=
# Doubles as the {AccountSid} path segment and the Basic-auth username.
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
# SignalWire's answer to a Messaging Service: a Number Group id (a UUID, not an
# MG... SID). Provisioned on the Relay REST API, not the compatibility one.
SIGNALWIRE_NUMBER_GROUP_ID=
SIGNALWIRE_FROM_NUMBER=
# Only if inbound webhooks start failing with a signature mismatch. Their docs
# never say which secret signs a webhook, so this defaults to the API token;
# set it explicitly to the Space's signing key if that turns out to be wrong.
SIGNALWIRE_SIGNING_KEY=

# HMAC secret for stateless lead phone-verification tokens. NOT a provider
# credential — it only ever lived on TWILIO_AUTH_TOKEN by accident, and the
# fallback below exists so renaming that variable does not invalidate every
# in-flight token. Set this to the CURRENT value of TWILIO_AUTH_TOKEN when you
# first add it, then rotate it on its own schedule. It must be set before
# TWILIO_AUTH_TOKEN is removed: with neither present, phone verification stops
# running and every affected lead is flagged as unverified.
LGQ_LEAD_VERIFICATION_SECRET=

# Signing secret for the Resend delivery-status webhook (bounces/complaints,
# recorded into email_events for the admin Command Center). Set once the
# webhook is configured in the Resend dashboard against /api/resend/webhook.
RESEND_WEBHOOK_SECRET=

# Internal admin console (/admin) staff allowlist. Comma-separated; each entry
# is either a bare email (role defaults to "admin") or "email:role" where role
# is one of admin|support|finance. Role only changes Command Center's default
# card set and nav visibility — every listed email is a full admin for server
# actions. Only these logged-in users can reach /admin; everyone else gets a 404.
ADMIN_EMAILS=
