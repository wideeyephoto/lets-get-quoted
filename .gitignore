node_modules/
dist/
tmp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# Next.js build output and local TypeScript cache
.next/
# next.config's distDir override (NEXT_DIST_DIR) exists so a verification build
# doesn't clobber the running dev server's .next — but only ".next/" was ignored,
# so every alternate dist dir it produced showed up as untracked build output
# waiting to be committed by a stray `git add -A`. "undefined/" is the same thing
# after an unset NEXT_DIST_DIR got stringified into the path.
.next-*/
undefined/
out/
build/
*.tsbuildinfo
.vercel
.env*

.projects/cache
.projects/vault
.projects/state.test.json
.projects/state.local.test.json
.env
.env.*
!.env.example

# Claude Code machine-local permissions and preferences
.claude/settings.local.json

# throwaway scratch files (commit messages, one-off e2e scripts)
_*.txt
_*.mjs
_e2e-*
build-out.txt
out-build.txt
scratch_*.mjs

# Seed manifests — ids of rows a seeder wrote, so --undo can delete exactly those.
scripts/.seed-*.json
scripts/.*.json

# Source assets staged for the site — 49MB of screenshots, icon sets and photo
# exports that get processed into public/ rather than shipped from here. Kept
# out of the tree so a clone is not half a gigabyte of things nothing imports.
FILES/

# Scratch probes. Agents write these into the repo so `pg` resolves; they are
# never part of the tree.
scripts/tmp-*.mjs

# Generated video/screen capture recording artifacts
artifacts/
test-results/
.audit-tmp/
supabase/.temp/
