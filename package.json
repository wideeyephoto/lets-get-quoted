    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.24",
    "playwright": "^1.62.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "postcss": "^8.5.26"
  }
}
