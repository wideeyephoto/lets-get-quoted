{
  "name": "lets-get-quoted",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg17:late-success": "tsc --noEmit -p tsconfig.test.json && vitest run --config vitest.pg17.config.ts",
    "test:pg17:storage-usage": "node scripts/verify-storage-usage-migration.mjs",
    "test:pg17:capacity-grant": "node scripts/verify-top-up-capacity-grant.mjs",
    "test:pg17:capacity-lifecycle": "node scripts/verify-purchased-capacity-lifecycle.mjs",
    "test:pg17:proconfig": "node scripts/verify-late-success-proconfig.mjs",
    "test:pg17:catalog-bump": "node scripts/verify-entitlement-catalog-bump.mjs",
    "test:pg17:flex-limits": "node scripts/verify-new-workspace-flex-limits.mjs",
    "test:pg17:grace-collect": "node scripts/verify-grace-may-still-collect.mjs",
    "test:pg17:ledger-contract": "node scripts/verify-usage-meter-ledger-contract.mjs",
    "test:pg17:office-collision": "node scripts/verify-office-seat-collision.mjs",
    "test:pg17:voice-allowance": "node scripts/verify-voice-minute-allowance.mjs",
    "test:pg17:truncate": "node scripts/verify-truncate-revoke.mjs",
    "test:pg17:voice-inbox": "node scripts/verify-voice-event-inbox.mjs",
    "test:pg17:partial-commit": "node scripts/verify-partial-commit.mjs",
    "test:pg17:overage": "node scripts/verify-usage-overage-authorization.mjs",
    "test:seo": "node --test src/lib/seo/seo-copy.test.mjs",
    "test:stock": "node --test src/lib/stock/stock.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.49.1",
    "geist": "^1.7.2",
    "next": "14.2.15",
    "pdfkit": "^0.19.1",
    "pg": "^8.12.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "read-excel-file": "^9.3.4",
    "resend": "^3.5.0",
    "stripe": "^22.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.120",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify/utils": "^3.1.4",
    "@types/google.maps": "^3.65.2",
    "@types/node": "^22.10.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.15",
    "playwright": "^1.62.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}
